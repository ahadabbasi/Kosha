@using Kosha.CustomerManager.Web.Areas.Obligation.Models.ViewComponents
@using Kosha.CustomerManager.Web.Infrastructure.Helper.Task.Model
@using Kosha.CustomerManager.Web.Infrastructure.Models.Paginate
@using Microsoft.AspNetCore.Routing
@model PaginateResponse<ITaskPaginateResponse>

@section Styles
{
    <link rel="stylesheet" href="~/css/obligation.css" />
}

<div class="flex grow flex-col">
    <div class="flex grow gap-1 relative">
        <!-- List View -->
        <div class="bg-background border border-input rounded-xl shadow-xs w-full lg:w-[300px] xl:w-(--mail-list-width) shrink-0">
            <!--Header-->
            <div class="flex items-center justify-between px-2 py-3 gap-1">
                <div class="flex items-center w-full gap-1">
                </div>
            </div>
            <!--End Header-->
            <!-- List -->

            <div class="px-4 py-1">
                @foreach (ITaskPaginateResponse item in Model)
                {
                    <!-- Each item -->
                    <div class="group flex items-center gap-2.5 p-2 rounded-lg cursor-pointer transition-colors relative hover:bg-secondary">

                        <!-- Information -->
                        <div class="flex-1 space-y-0.5">
                            <div class="flex items-center justify-between">
                                <a class="font-medium text-sm text-foreground hover:text-primary" href="#">
                                    @item.Title
                                </a>
                                <!-- Date -->
                                <span class="text-xs text-secondary-foreground">
                                    @item.Inserted
                                </span>
                                <!-- End Date -->
                            </div>
                            <p class="text-xs text-muted-foreground font-normal">
                                @item.Description
                            </p>
                        </div>
                        <!-- End Information -->
                    </div>
                    <!-- End Each item -->
                }
            </div>

            <!-- End List -->
        </div>
        <!-- End List View -->
        <!-- Message View -->
        <div class="bg-background border border-input rounded-xl shadow-xs grow lg:w-[calc(100%-300px)] xl:w-(--mail-view-width) lg:block">
            @await Component.InvokeAsync(nameof(AccessTokenViewComponent).RemoveViewComponentFromString())
            <div id="react-element"></div>
        </div>
        <!-- End Message View -->
    </div>

    <div class="flex items-center flex-col mt-2 kt-card py-2">
        @await Html.RenderPaginateNavbarAsync(page => {
            RouteValueDictionary values = 
                new RouteValueDictionary(
                    [
                        new KeyValuePair<string, object?>("Area", AreaNameConfiguration.Obligation),
                        new KeyValuePair<string, object?>("Page", page),
                        new KeyValuePair<string, object?>("Size", 10)
                    ]
                );

                //Html.ViewContext.HttpContext.Request.Query.

                return Url.Action(
                    nameof(HomeController.Index),
                    nameof(HomeController).RemoveControllerFromString(),
                    values
                );
        })

    </div>
</div>

@section Scripts
{
    <script src="~/lib/react/umd/react.development.js"></script>
    <script src="~/lib/react-dom/umd/react-dom.development.js"></script>
    <script src="~/lib/htm/dist/htm.umd.js"></script>
    <script src="~/lib/axios/dist/axios.js"></script>
    <script src="~/js/renderer.js"></script>
    <script src="~/js/token.js"></script>
    <script src="~/js/request.js"></script>
    <script src="~/js/modal.js"></script>
    <script src="~/js/suggest.js"></script>
    <script src="~/js/tag.js"></script>
    <script src="~/js/contact.js"></script>
    <script src="~/js/action.js"></script>
    <script src="~/js/obligation.js"></script>
}
