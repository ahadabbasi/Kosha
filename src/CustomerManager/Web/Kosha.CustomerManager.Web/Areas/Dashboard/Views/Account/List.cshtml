@using Kosha.CustomerManager.Web.Infrastructure.Models.Authentication.User
@using Kosha.CustomerManager.Web.Infrastructure.Models.Paginate
@model PaginateResponse<UserResponse>

<div class="kt-card kt-card-grid h-full min-w-full">
    <div class="kt-card-header">
        <h3 class="kt-card-title">
            کاربران
        </h3>
        <div class="border rounded border-gray-200">
            <a href="@Url.Action(nameof(AccountController.Create), nameof(AccountController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard })" class="kt-btn kt-btn-icon kt-btn-dim">
                <i class="ki-filled ki-plus">
                </i>
            </a>
        </div>
    </div>
    <div class="kt-card-table">
        <div class="grid datatable-initialized" id="teams_datatable">
            <div class="kt-scrollable-x-auto">
                <table class="kt-table kt-table-border table-fixed" id="kt_datatable_1">
                    <thead>
                    <tr>
                        <th class="w-[135px]">
                            <span class="kt-table-col">
                                <span class="kt-table-col-label">
                                    نام کاربری
                                </span>
                            </span>
                        </th>
                        <th class="w-[135px]">
                            <span class="kt-table-col">
                                <span class="kt-table-col-label">
                                    نام
                                </span>
                            </span>
                        </th>
                        <th class="w-[135px]">
                            <span class="kt-table-col">
                                <span class="kt-table-col-label">
                                    نام خانوادگی
                                </span>
                            </span>
                        </th>
                        <th class="w-[135px]">
                            <span class="kt-table-col">
                                <span class="kt-table-col-label">
                                    شماره تماس
                                </span>
                            </span>
                        </th>
                        <th class="w-[135px]">
                            <span class="kt-table-col">
                                <span class="kt-table-col-label">
                                </span>
                            </span>
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    
                    @if (Model.Any())
                    {
                        @foreach (UserResponse item in Model)
                        {
                            <tr>
                                <td>@item.Username</td>
                                <td>@item.Name</td>
                                <td>@item.Family</td>
                                <td>@item.PhoneNumber</td>
                                <td></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5">
                                کاربری برای نمایش یافت نشد
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="kt-card-footer justify-center md:justify-between flex-col md:flex-row gap-5 text-secondary-foreground text-sm font-medium mt-auto">
                @await Html.RenderPaginateNavbarAsync(page => Url.Action(
                    nameof(AccountController.List),
                    nameof(AccountController).RemoveControllerFromString(),
                    new
                    {
                        Area = AreaNameConfiguration.Dashboard, 
                        Page = page, 
                        Size = 10
                    }
                ))
            </div>
        </div>
    </div>
</div>