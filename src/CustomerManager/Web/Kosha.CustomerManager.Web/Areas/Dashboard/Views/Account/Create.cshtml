@model CreateUserVm

@using (
    Html.BeginForm(
        nameof(AccountController.Create),
        nameof(AccountController).RemoveControllerFromString(),
       new { Area = AreaNameConfiguration.Dashboard },
        FormMethod.Post,
        true,
        new { @class = "grid gap-5" }
    )
)
{
    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Name" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Name" class="kt-input" type="text">
        </div>
    </div>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Family" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Family" class="kt-input" type="text">
        </div>
    </div>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="PhoneNumber" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="PhoneNumber" class="kt-input" type="text">
        </div>
    </div>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Username" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Username" class="kt-input" type="text">
        </div>
    </div>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Password" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Password" class="kt-input" type="text">
        </div>
    </div>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="ConfirmPassword" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="ConfirmPassword" class="kt-input" type="text">
        </div>
    </div>

    <div class="flex justify-end pt-2.5">
        <button class="kt-btn kt-btn-primary" type="submit">
            ذخیره
        </button>
    </div>
}