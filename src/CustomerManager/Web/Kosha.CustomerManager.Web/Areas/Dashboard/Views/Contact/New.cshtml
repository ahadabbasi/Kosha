@using Kosha.CustomerManager.Web.Areas.Dashboard.Models.ViewComponents
@model NewContactVm

@using (
    Html.BeginForm(
        nameof(ContactController.New),
        nameof(ContactController).RemoveControllerFromString(),
       new { Area = AreaNameConfiguration.Dashboard, Model.Customer },
        FormMethod.Post,
        true,
        new { @class = "grid gap-5" }
    )
)
{
    <div class="text-base font-semibold text-mono">
        ثبت راه ارتباطی جدید برای مشتری @Model.CustomerName @Model.CustomerFamily
    </div>

    <div class="border-t border-border mt-2 mb-8"></div>

    <input asp-for="Customer" type="hidden">

    <input asp-for="CustomerName" type="hidden">

    <input asp-for="CustomerFamily" type="hidden">

    @(
        await Component.InvokeAsync(
            nameof(ContactTypeViewComponent).RemoveViewComponentFromString(),
            new ContactTypeRequest(
                nameof(Model.Type),
                DisplayNameConfiguration.Type,
                Model.Type
            )
        )
    )

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Value" class="kt-form-label flex items-center gap-1 max-w-56"></label>
            <input asp-for="Value" class="kt-input" type="text">
        </div>
    </div>

    <div class="flex justify-end pt-2.5">
        <button class="kt-btn kt-btn-primary" type="submit">
            ذخیره
        </button>
    </div>
}