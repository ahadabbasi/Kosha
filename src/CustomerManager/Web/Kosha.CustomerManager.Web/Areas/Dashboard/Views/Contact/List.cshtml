@using Kosha.CustomerManager.Web.Infrastructure.Models.Customer
@model CustomerContactListResponse

<div class="kt-card kt-card-grid h-full min-w-full">
    <div class="kt-card-header">
        <h3 class="kt-card-title">
            شماره های تماس مشتری @Model.Name @Model.Family
        </h3>
        <div class="border rounded border-gray-200">
            <a href="@Url.Action(nameof(ContactController.New), nameof(ContactController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard, Customer = Model.Id })" class="kt-btn kt-btn-icon kt-btn-dim">
                <i class="ki-filled ki-plus">
                </i>
            </a>
        </div>
    </div>
    <div class="kt-card-table">
        <div class="grid datatable-initialized" id="teams_datatable">
            <div class="kt-scrollable-x-auto">
                <table class="kt-table kt-table-border table-fixed" id="kt_datatable_1">
                    <thead>
                        <tr>
                            <th class="w-[135px]">
                                <span class="kt-table-col">
                                    <span class="kt-table-col-label">
                                        نام خانوادگی
                                    </span>
                                </span>
                            </th>
                            <th class="w-[135px]">
                                <span class="kt-table-col">
                                    <span class="kt-table-col-label">
                                        شماره تماس
                                    </span>
                                </span>
                            </th>
                            <th class="w-[135px]">
                                <span class="kt-table-col">
                                    <span class="kt-table-col-label">
                                    </span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (CustomerContactResponse item in Model)
                            {
                                <tr>
                                    <td>@item.Type</td>
                                    <td>@item.Value</td>
                                    <td>
                                        <a class="kt-btn kt-btn-ghost" href="@Url.Action(nameof(ContactController.Update), nameof(ContactController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard, Customer = Model.Id, item.Id })">
                                            <i class="ki-filled ki-pencil"></i>
                                        </a>
                                        <a class="kt-btn kt-btn-ghost" href="@Url.Action(nameof(ContactController.Delete), nameof(ContactController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard, Customer = Model.Id, item.Id })">
                                            <i class="ki-filled ki-trash"></i>
                                        </a> 
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">
                                    کاربری برای نمایش یافت نشد
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>