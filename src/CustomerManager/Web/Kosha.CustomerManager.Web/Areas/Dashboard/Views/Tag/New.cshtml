@model NewTagVm

@using (
    Html.BeginForm(
        nameof(TagController.New),
        nameof(TagController).RemoveControllerFromString(),
       new { Area = AreaNameConfiguration.Dashboard },
        FormMethod.Post,
        true,
        new { @class = "grid gap-5" }
    )
)
{
    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Title" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Title" class="kt-input" type="text">
        </div>
    </div>

    <div class="flex justify-end pt-2.5">
        <button class="kt-btn kt-btn-primary" type="submit">
            ذخیره
        </button>
    </div>
}