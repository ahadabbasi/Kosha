@using Kosha.CustomerManager.Web.Areas.Dashboard.Models.ViewComponents
@using Kosha.CustomerManager.Web.Infrastructure.Models.Paginate
@using Kosha.CustomerManager.Web.Infrastructure.Models.Customer
@model PaginateResponse<CustomerPaginateResponse>

<div class="kt-card kt-card-grid h-full min-w-full">
    <div class="kt-card-header">
        <h3 class="kt-card-title">
            مشتریان
        </h3>
        <div class="border rounded border-gray-200">
            <a href="@Url.Action(nameof(CustomerController.Create), nameof(CustomerController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard })" class="kt-btn kt-btn-icon kt-btn-dim">
                <i class="ki-filled ki-plus">
                </i>
            </a>
        </div>
    </div>
    <div class="kt-card-table">
        <div class="grid datatable-initialized" id="teams_datatable">
            <div class="kt-scrollable-x-auto">
                <table class="kt-table kt-table-border table-fixed" id="kt_datatable_1">
                    <thead>
                        <tr>
                            <th class="w-[135px]">
                                <span class="kt-table-col">
                                    <span class="kt-table-col-label">
                                        نام
                                    </span>
                                </span>
                            </th>
                            <th class="w-[135px]">
                                <span class="kt-table-col">
                                    <span class="kt-table-col-label">
                                        نام خانوادگی
                                    </span>
                                </span>
                            </th>
                            <th class="w-[135px]">
                                <span class="kt-table-col">
                                    <span class="kt-table-col-label">
                                    </span>
                                </span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (CustomerPaginateResponse item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Family</td>
                                    <td>
                                        <a class="kt-btn kt-btn-ghost" href="@Url.Action(nameof(ContactController.List), nameof(ContactController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard, Customer = item.Id })">
                                            <i class="ki-filled ki-phone"></i>
                                        </a>
                                        <a class="kt-btn kt-btn-ghost" href="@Url.Action(nameof(CustomerController.Edit), nameof(CustomerController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard, item.Id })">
                                            <i class="ki-filled ki-pencil"></i>
                                        </a>
                                        <a class="kt-btn kt-btn-ghost" href="@Url.Action(nameof(CustomerController.Delete), nameof(CustomerController).RemoveControllerFromString(), new { Area = AreaNameConfiguration.Dashboard, item.Id })">
                                            <i class="ki-filled ki-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">
                                    مشتری برای نمایش یافت نشد
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="kt-card-footer justify-center md:justify-between flex-col md:flex-row gap-5 text-secondary-foreground text-sm font-medium">
                @(
                    await Component.InvokeAsync(
                    nameof(PaginateViewComponent).RemoveViewComponentFromString(),
                        new CreatePaginateNavbarVm(
                            Model,
                page =>
                                Url.Action(
                                    nameof(CustomerController.List),
                                    nameof(CustomerController).RemoveControllerFromString(),
                                    new
                                    {
                                        Area = AreaNameConfiguration.Dashboard,
                                        Page = page,
                                        Size = 10
                                    }
                                )
                        )
                    )
                )
            </div>
        </div>
    </div>
</div>