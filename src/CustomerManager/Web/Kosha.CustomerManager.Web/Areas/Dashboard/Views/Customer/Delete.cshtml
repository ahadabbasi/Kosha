@model UpdateCustomerVm

@using (
    Html.BeginForm(
        nameof(CustomerController.Delete),
        nameof(CustomerController).RemoveControllerFromString(),
        new { Area = AreaNameConfiguration.Dashboard, Model.Id },
        FormMethod.Post,
        true,
        new { @class = "grid gap-5" }
    )
)
{
    <input asp-for="Id" type="hidden"/>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Name" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Name" class="kt-input" type="text" readonly="readonly">
        </div>
    </div>

    <div class="w-full">
        <div class="flex items-baseline flex-wrap lg:flex-nowrap gap-2.5">
            <label asp-for="Family" class="kt-form-label flex items-center gap-1 max-w-56">
            </label>
            <input asp-for="Family" class="kt-input" type="text" readonly="readonly">
        </div>
    </div>

    <div class="flex justify-end pt-2.5">
        <button class="kt-btn kt-btn-destructive" type="submit">
            حذف
        </button>
    </div>
}