@using Kosha.CustomerManager.Web.Areas.Account.Controllers
@using Kosha.CustomerManager.Web.Models.Configurations
@using Kosha.CustomerManager.Web.Models.Extensions
@model Kosha.CustomerManager.Web.Areas.Account.Models.ViewModels.LoginVm


@using (
    Html.BeginForm(
        nameof(LoginController.Index),
        nameof(LoginController).RemoveControllerFromString(), 
       new { Area = AreaNameConfiguration.Account }, 
       FormMethod.Post, 
        true, 
        new { @class = "kt-card-content flex flex-col gap-5 p-10", id = "sign_in_form" }
    )
)
{
    @Html.HiddenFor(model => model.ReturnUrl)

    <div class="text-center mb-2.5">
        <h3 class="text-lg font-medium text-mono leading-none mb-2.5">
            ورود به سامانه
        </h3>
    </div>
    <div class="flex flex-col gap-2">
        <label asp-for="Username" class="kt-form-label font-normal text-mono"></label>
        <input asp-for="Username" class="kt-input text-left" placeholder="@Html.Raw(Html.DisplayNameFor(model => model.Username))" type="text" value="" />
    </div>
    <div class="flex flex-col gap-2">
        <div class="flex items-center justify-between gap-2">
            <label asp-for="Password" class="kt-form-label font-normal text-mono"></label>
            <!--<a class="text-sm kt-link shrink-0" href="html/demo1/authentication/classic/reset-password/enter-email.html">
                Forgot Password?
            </a>-->
        </div>
        <div class="kt-input flex-row-reverse" data-kt-toggle-password="true">
            <input asp-for="Password" class="text-left" placeholder="@Html.Raw(Html.DisplayNameFor(model => model.Password))" type="password" value="" />
            <button class="kt-btn kt-btn-sm kt-btn-ghost kt-btn-icon bg-transparent! -me-1.5" data-kt-toggle-password-trigger="true" type="button">
                <span class="kt-toggle-password-active:hidden">
                    <i class="ki-filled ki-eye text-muted-foreground">
                    </i>
                </span>
                <span class="hidden kt-toggle-password-active:block">
                    <i class="ki-filled ki-eye-slash text-muted-foreground">
                    </i>
                </span>
            </button>
        </div>
    </div>
    <label class="kt-label">
        <input asp-for="RememberMe" class="kt-checkbox kt-checkbox-sm" name="check" type="checkbox" value="1" />
        <span class="kt-checkbox-label">
            مرا به خاطر بسپار
        </span>
    </label>
    <button class="kt-btn kt-btn-primary flex justify-center grow">
        ورود
    </button>
}
